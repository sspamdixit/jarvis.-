{
  "productName": "david",
  "version": "0.1.0",
  "identifier": "com.personal.david-assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:tauri",
    "beforeBuildCommand": "pnpm build:tauri"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "david",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "nsis": {
      "displayLanguageSelector": false,
      "installMode": "currentUser"
    }
  }
}
